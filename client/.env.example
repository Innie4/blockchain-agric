# Base URL of the API. Leave as /api to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# Solana network the client talks to: devnet | testnet | mainnet-beta | localnet
VITE_SOLANA_NETWORK=devnet

# Optional: read-only RPC endpoint for the wallet adapter. Leave empty to use the
# wallet's own default for the selected cluster.
VITE_SOLANA_RPC_URL=

# Deployed address of the on-chain supply chain program.
VITE_SOLANA_PROGRAM_ID=AgriTraceSupplyChain11111111111111111111111111111111
