# Keep development dependencies installed, even when NODE_ENV=production.
#
# This project is built on the machine that deploys it: the API is compiled with
# `tsc`, and the interface is bundled with `vite`. Both the compiler and the
# type declarations they read are devDependencies, so an install that omits them
# cannot build:
#
#   src/routes/users.ts(1,53): error TS7016: Could not find a declaration file
#   for module 'express'
#   src/routes/users.ts(660,33): error TS2694: Namespace 'global.Express' has no
#   exported member 'Multer'
#
# `NODE_ENV=production` makes npm default to omitting devDependencies, which is
# the right default for an application that ships prebuilt output. It is the
# wrong default for a service that is compiled during the build, and hosts such as
# Render and Vercel set it. Setting `include` cancels the implied omission, so the
# build finds the tools it needs without every host having to override its own
# install flags.
#
# The trade is that the compiler and the type packages are installed on the
# runtime image as well. That is the deliberate cost of building on the deploy
# host; the alternative is shipping compiled output in the repository, which
# would put build output under version control and let it drift from the source.
include=dev
