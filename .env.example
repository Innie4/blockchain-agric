# =============================================================================
# Blockchain-Based Decentralised Ecosystem for Transparent Agricultural
# Supply Chain Management — environment configuration
# =============================================================================
#
# Copy this file to `.env` in the repository root and fill in the values.
#
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Then start the services:
#
#   npm install
#   npm run dev:server
#   npm run dev:client
#
# The API validates this file when it starts and refuses to run with a precise
# list of anything missing, so a half-configured process never reaches a
# participant. Every variable below is read by code in `server/src` or
# `client/src`; none is decorative.
#
# Only the four `VITE_*` variables are sent to the browser. Everything else is
# server-only and must never be prefixed `VITE_`.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# Interface only. `development`, `test` or `production`.
NODE_ENV=development

# Port the API listens on. Change it if something else already holds 4000.
PORT=4000

# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Absolute URL of this API. Used in log lines and in the links a report prints.
API_BASE_URL=http://localhost:4000

# Absolute URL of the React client. The verification link written into a batch's
# QR code is built from this, so it must be the address a buyer will actually
# open — not localhost — before you print a code for real produce.
CLIENT_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call this API with
# credentials. Anything else is refused by the CORS middleware.
CORS_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
# MONGODB
# -----------------------------------------------------------------------------
# Connection string for the off-chain database. It holds participant profiles,
# batch metadata, certificates, processing and transport logs, transfers,
# verification history, compliance reports and the uploaded files (GridFS).
#
# The value shown works for a local MongoDB with no authentication. For Atlas
# or any authenticated deployment, use the connection string Atlas gives you:
#   mongodb+srv://<user>:<password>@<cluster>/agri_trace?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name inside that connection string.
MONGODB_DB_NAME=agri_trace

# Maximum connections in the driver's pool.
MONGODB_MAX_POOL_SIZE=20


# -----------------------------------------------------------------------------
# SOLANA
# -----------------------------------------------------------------------------
# Cluster: devnet, testnet, mainnet-beta or localnet.
# This project targets devnet. Use localnet with a local validator.
SOLANA_NETWORK=devnet

# JSON-RPC endpoint. The public Devnet endpoint is rate limited and is fine for
# development; use a provider's own endpoint for anything sustained.
#   devnet  https://api.devnet.solana.com
#   local   http://127.0.0.1:8899
SOLANA_RPC_URL=https://api.devnet.solana.com

# WebSocket endpoint, used for subscription-based reads.
#   devnet  wss://api.devnet.solana.com
#   local   ws://127.0.0.1:8900
SOLANA_WS_URL=wss://api.devnet.solana.com

# Address of the deployed on-chain program. This is the value `anchor deploy`
# prints. For a local validator it is whatever Anchor reports; for Devnet it is
# the address of your deployment.
SOLANA_PROGRAM_ID=CTKBH9KnbTd8zL4sHNpj4CBPPQcHu2uZk613WpA1ZiDm

# Commitment the API waits for before it calls a transaction confirmed:
# processed, confirmed or finalized. `confirmed` is the sensible default;
# `finalized` is slower and `processed` is weaker.
SOLANA_COMMITMENT=confirmed

# Commitment used for the pre-flight simulation. `none` disables the
# preflight check, which is not recommended.
SOLANA_PREFETCH_COMMITMENT=confirmed

# How long to wait for a transaction to reach the configured commitment, in
# milliseconds. After this the API reports a timeout and tells the participant
# the transaction may still settle.
SOLANA_TX_TIMEOUT_MS=90000

# How many times the RPC client will retry a submission.
SOLANA_RETRY_ATTEMPTS=3


# -----------------------------------------------------------------------------
# AUTHENTICATION AND SESSIONS
# -----------------------------------------------------------------------------
# Secret used to derive session-bound values. MUST be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Change it for every deployment. A shared secret across environments is a
# shared vulnerability.
SESSION_SECRET=

# How long a sign-in challenge stays valid, in seconds. A challenge is
# single-use; this is only the window in which it may be signed.
AUTH_NONCE_TTL_SECONDS=300

# How long a session lasts, in seconds. Default 604800 is seven days.
SESSION_TTL_SECONDS=604800

# Send the session cookie only over HTTPS. Must be true in production, and must
# be true whenever COOKIE_SAME_SITE is none.
COOKIE_SECURE=false

# lax, strict or none. Use lax unless the client and API are on different sites,
# in which case use none together with COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax

# Optional. Set this only when the API and the client share a parent domain,
# for example app.example.com and api.example.com. Leave blank otherwise.
COOKIE_DOMAIN=

# Optional. Set to the number of reverse proxies in front of the API (for
# example 1 behind a single nginx) so rate limiting and secure cookies see the
# real client address. Leave blank when there is no proxy.
TRUST_PROXY=


# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# Uploaded images, certificates and supporting documents are stored in MongoDB
# through GridFS, so there is no separate object-storage account to provision.
# These two limits are all that governs uploads.

# Largest single upload, in bytes. Default 5242880 is 5 MB.
UPLOAD_MAX_FILE_BYTES=5242880

# Largest number of files accepted in one request.
UPLOAD_MAX_FILES_PER_REQUEST=10


# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Window all limits below are counted over, in milliseconds.
RATE_LIMIT_WINDOW_MS=60000

# Requests per window for any signed-in or anonymous caller on the general API.
RATE_LIMIT_MAX_AUTHENTICATED=300

# Requests per window for the public verification and search routes.
RATE_LIMIT_MAX_PUBLIC=120

# Requests per window for issuing and verifying wallet sign-in challenges.
RATE_LIMIT_MAX_AUTH_ATTEMPTS=20

# Requests per window for multipart uploads.
RATE_LIMIT_MAX_UPLOADS=60


# -----------------------------------------------------------------------------
# OPERATIONS
# -----------------------------------------------------------------------------
# How long a completed idempotency key is remembered, in seconds. This is what
# makes a retried registration or transfer replay its original answer instead of
# creating a second blockchain transaction.
IDEMPOTENCY_TTL_SECONDS=86400

# Record a reconciliation task and notify regulators when a transaction confirms
# on-chain but the database write fails. Leave this on: it is the mechanism that
# stops a confirmed action from being silently lost.
RECONCILIATION_ENABLED=true


# =============================================================================
# FRONTEND (the only values the browser receives)
# =============================================================================
# Anything prefixed VITE_ is embedded in the JavaScript bundle and is therefore
# public. Never put a secret, a private key or a database credential here.

# Base URL of the API. Leave as /api to use the Vite development proxy, which
# avoids cross-origin cookies in development. In production set the full URL,
# for example https://api.example.com/api
VITE_API_BASE_URL=/api

# Cluster the client talks to: devnet, testnet, mainnet-beta or localnet. Must
# match SOLANA_NETWORK, or a participant will be prompted to switch networks
# mid-transaction.
VITE_SOLANA_NETWORK=devnet

# Optional read-only RPC endpoint for the wallet. Leave empty to use the
# wallet's own default for the selected cluster.
VITE_SOLANA_RPC_URL=

# Address of the deployed program. Must match SOLANA_PROGRAM_ID; the client
# shows it read-only so a participant can confirm which program they are about
# to sign for.
VITE_SOLANA_PROGRAM_ID=CTKBH9KnbTd8zL4sHNpj4CBPPQcHu2uZk613WpA1ZiDm

# -----------------------------------------------------------------------------
# DEMONSTRATION DATA
# -----------------------------------------------------------------------------
# Set to true to run the whole interface on placeholder data: no database, no
# chain connection and no wallet needed, and every screen populated so the product
# can be reviewed on its own. Off by default.
#
# It is ignored in a production build unless DEMO_DATA_ACK is also set, so a public
# deployment cannot serve fixture data to a real consumer. The interface does not
# announce itself while it is on.
#
# Both names are listed in `envPrefix` in client/vite.config.ts. Vite only inlines
# the variable prefixes it has been told about, and everything it inlines is public
# in the browser bundle, so these are build switches rather than secrets.
#
# The batches carry registration fingerprints computed by the server's own
# canonical module, so the verification screens are showing real arithmetic over
# placeholder facts rather than invented strings.
DEMO_DATA=false

# Only relevant if DEMO_DATA is true in a production build. Must be exactly the
# text below, so turning this on is a decision rather than an accident.
DEMO_DATA_ACK=